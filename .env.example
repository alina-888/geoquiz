# Django Settings
# Generate a new secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/geoquiz

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# File Upload Limits (in bytes)
# MAX_IMAGE_SIZE=10485760
# MAX_AUDIO_SIZE=52428800
# MAX_VIDEO_SIZE=104857600
# MAX_USER_STORAGE=524288000
